<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-pink-50">

  <div class="max-w-md mx-auto mt-20 bg-white p-6 rounded-2xl shadow-lg">

    <h1 class="text-3xl font-bold text-center text-pink-600 mb-6">
      Contact Us
    </h1>

    <form class="space-y-4">

      <input 
        type="text"
        placeholder="Your Name"
        class="w-full border p-3 rounded-xl"
      >

      <input
        type="email"
        placeholder="Your Email"
        class="w-full border p-3 rounded-xl"
      >

      <textarea
        placeholder="Your Message"
        class="w-full border p-3 rounded-xl h-32"
      ></textarea>

      <button
        class="w-full bg-pink-500 text-white p-3 rounded-xl"
      >
        Send Message
      </button>

    </form>

  </div>

</body>
</html>
